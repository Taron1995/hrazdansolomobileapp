@page
@model UGeekStore.Pages.Employees.IndexModel
@{ ViewData["Title"] = "Աշխատակիցներ"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Աշխատակիցներ</h1>
    <a class="btn btn-brand" href="/Employees/Edit">+ Ավելացնել</a>
</div>
<p class="small text-muted">Յուրաքանչյուր աշխատակից մտնում է իր Gmail հասցեով և տեսնում է միայն իր դերի ծրագիրը (գանձապահ, մենեջեր, հրուշակագործ, առաքիչ)։</p>
@foreach (var g in Model.Employees.GroupBy(e => e.Role).OrderBy(g => g.Key))
{
    <h2 class="h6 mt-3">@g.Key.Hy()</h2>
    <div class="list-group">
    @foreach (var e in g)
    {
        <a class="list-group-item list-group-item-action @(e.IsActive ? "" : "text-muted")" href="/Employees/Edit/@e.Id">
            <b>@e.FullName</b> <span class="small">@e.Email</span> @if (!e.IsActive) { <span class="badge bg-secondary">ապաակտիվ</span> }
        </a>
    }
    </div>
}
<div class="card card-body mt-4">
    <h2 class="h6">Դրամարկղեր</h2>
    @foreach (var r in Model.Registers)
    {
        <form method="post" asp-page-handler="Register" class="d-flex gap-2 mb-2">
            <input type="hidden" name="id" value="@r.Id" />
            <input name="name" value="@r.Name" class="form-control" />
            <label class="small d-flex align-items-center gap-1"><input type="checkbox" name="active" value="true" checked="@r.IsActive" /> ակտիվ</label>
            <button class="btn btn-outline-dark">✓</button>
        </form>
    }
    <form method="post" asp-page-handler="Register" class="d-flex gap-2">
        <input name="name" class="form-control" placeholder="Նոր դրամարկղ" required />
        <input type="hidden" name="active" value="true" />
        <button class="btn btn-outline-dark">+</button>
    </form>
</div>
