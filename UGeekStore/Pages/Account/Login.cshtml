@page
@model UGeekStore.Pages.Account.LoginModel
@{ ViewData["Title"] = "Մուտք"; }
<div class="row justify-content-center mt-4">
    <div class="col-12 col-sm-8 col-md-5">
        <h1 class="h3 mb-3 text-center">Մուտք համակարգ</h1>
        @if (Model.Error != null) { <div class="alert alert-danger">@Model.Error</div> }
        @if (Model.GoogleEnabled)
        {
            <a class="btn btn-brand w-100 mb-3" href="?handler=Google&returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "/")">Մուտք Gmail-ով</a>
            <div class="text-center text-muted small mb-3">կամ</div>
        }
        <form method="post" class="card card-body">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label class="form-label">Էլ. փոստ</label>
                <input asp-for="Email" class="form-control" type="email" autocomplete="username" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Գաղտնաբառ</label>
                <input asp-for="Password" class="form-control" type="password" autocomplete="current-password" required />
            </div>
            <button class="btn btn-brand w-100">Մուտք</button>
        </form>
    </div>
</div>
