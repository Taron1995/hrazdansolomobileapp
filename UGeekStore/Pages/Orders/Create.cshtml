@page
@model UGeekStore.Pages.Orders.CreateModel
@{ ViewData["Title"] = "Նոր պատվեր"; }
<h1 class="h4 mb-3">Նոր պատվեր</h1>
<form method="post" id="orderForm" novalidate>
    <div asp-validation-summary="All" class="text-danger small"></div>

    <div class="card card-body mb-3">
        <label class="form-label">Պատվերի տեսակ</label>
        <div class="btn-group w-100 choice-group mb-1">
            @foreach (var t in Enum.GetValues<OrderType>())
            {
                <input type="radio" class="btn-check" name="Input.Type" id="otype_@t" value="@t" checked="@(Model.Input.Type == t)" />
                <label class="btn btn-outline-dark" for="otype_@t">@t.Hy()</label>
            }
        </div>
    </div>

    <div class="card card-body mb-3">
        <h2 class="h6">Հաճախորդ</h2>
        <div class="row g-2">
            <div class="col-12 col-md-4">
                <label class="form-label">Հեռախոս *</label>
                <input asp-for="Input.Phone" class="form-control" inputmode="tel" required id="phone" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">Անուն *</label>
                <input asp-for="Input.CustomerName" class="form-control" required id="custName" />
            </div>
            <div class="col-12 col-md-4 d-flex align-items-end"><div id="custInfo" class="small text-muted"></div></div>
        </div>
        <div id="issues" class="mt-2"></div>
    </div>

    <div class="card card-body mb-3">
        <h2 class="h6">Ապրանքներ</h2>
        <div id="items"></div>
        <button type="button" class="btn btn-outline-dark btn-sm mt-2" id="addItem">+ Ավելացնել տող</button>
        <div class="mt-3">
            <label class="form-label">Նկարագրություն / պատվերի մանրամասներ</label>
            <textarea asp-for="Input.Description" class="form-control" rows="3" placeholder="Ձևավորում, գրություն, քաշ, համ..."></textarea>
        </div>
        <div class="row g-2 mt-1">
            <div class="col-6"><label class="form-label">Ընդհանուր գին (֏)</label>
                <input asp-for="Input.TotalPrice" class="form-control" type="number" inputmode="decimal" min="0" id="total" /></div>
            <div class="col-6"><label class="form-label">Կանխավճար (֏)</label>
                <input asp-for="Input.Prepayment" class="form-control" type="number" inputmode="decimal" min="0" /></div>
        </div>
    </div>

    <div class="card card-body mb-3">
        <h2 class="h6">Կատարում</h2>
        <div class="row g-2">
            <div class="col-7 col-md-4"><label class="form-label">Պատրաստ լինելու օր *</label>
                <input asp-for="Input.DueDate" type="date" class="form-control" id="dueDate" required /></div>
            <div class="col-5 col-md-2"><label class="form-label">Ժամ *</label>
                <input asp-for="Input.DueTime" type="time" class="form-control" required /></div>
            <div class="col-12 col-md-6"><label class="form-label">Կատարող (հրուշակագործ)</label>
                <select asp-for="Input.ExecutorId" class="form-select" id="executor">
                    <option value="">— ընտրել —</option>
                    @foreach (var e in Model.Executors)
                    {
                        <option value="@e.Id" class="load-@e.Level">@e.Label</option>
                    }
                </select>
                <div class="small text-muted mt-1">Ցուցադրվում է ակտիվ պատվերների քանակը և ծանրաբեռնվածությունը ընտրված օրվա համար</div>
            </div>
        </div>
    </div>

    <div class="card card-body mb-3">
        <div class="form-check form-switch mb-2">
            <input asp-for="Input.IsDelivery" class="form-check-input" id="isDelivery" />
            <label class="form-check-label" for="isDelivery">Առաքում</label>
        </div>
        <div id="deliveryBlock" class="row g-2">
            <div class="col-12 col-md-6"><label class="form-label">Հասցե</label><input asp-for="Input.DeliveryAddress" class="form-control" id="address" /></div>
            <div class="col-6 col-md-3"><label class="form-label">Թաղամաս / շրջան</label>
                <input asp-for="Input.DeliveryDistrict" class="form-control" list="districts" id="district" />
                <datalist id="districts">@foreach (var d in Model.Districts) { <option value="@d"></option> }</datalist></div>
            <div class="col-6 col-md-3"><label class="form-label">Առաքման գին</label><input asp-for="Input.DeliveryFee" type="number" min="0" class="form-control" /></div>
            <div class="col-12 col-md-6"><label class="form-label">Առաքիչ</label>
                <select asp-for="Input.CourierId" class="form-select">
                    <option value="">— ընտրել —</option>
                    @foreach (var c in Model.Couriers) { <option value="@c.Id">@c.FullName (@c.Role.Hy())</option> }
                </select></div>
        </div>
    </div>

    <div class="d-flex gap-2 mb-5">
        <button class="btn btn-brand flex-fill">Պահպանել պատվերը</button>
        <a class="btn btn-outline-secondary flex-fill" href="/Orders">Չեղարկել</a>
    </div>
</form>

<template id="itemTpl">
    <div class="row g-2 item-row mb-2 align-items-end">
        <div class="col-12 col-md-5"><input class="form-control i-name" list="products" placeholder="Ապրանք" /></div>
        <div class="col-4 col-md-2"><input class="form-control i-qty" type="number" min="0.1" step="0.1" value="1" placeholder="Քանակ" /></div>
        <div class="col-5 col-md-2"><input class="form-control i-price" type="number" min="0" placeholder="Գին" /></div>
        <div class="col-3 col-md-1"><button type="button" class="btn btn-outline-danger w-100 i-del">✕</button></div>
        <input type="hidden" class="i-pid" />
    </div>
</template>
<datalist id="products">@foreach (var p in Model.Products) { <option value="@p.Name" data-id="@p.Id" data-price="@p.Price"></option> }</datalist>

@section Scripts {
<script>
(function () {
    const items = document.getElementById('items');
    const tpl = document.getElementById('itemTpl');
    const products = [...document.querySelectorAll('#products option')].map(o => ({ id: o.dataset.id, name: o.value, price: Number(o.dataset.price) }));
    const total = document.getElementById('total');
    let totalTouched = false;
    total.addEventListener('input', () => totalTouched = true);

    function renumber() {
        items.querySelectorAll('.item-row').forEach((r, i) => {
            r.querySelector('.i-name').name = `Input.Items[${i}].Name`;
            r.querySelector('.i-qty').name = `Input.Items[${i}].Quantity`;
            r.querySelector('.i-price').name = `Input.Items[${i}].UnitPrice`;
            r.querySelector('.i-pid').name = `Input.Items[${i}].ProductId`;
        });
    }
    function recalc() {
        if (totalTouched) return;
        let sum = 0;
        items.querySelectorAll('.item-row').forEach(r => sum += (Number(r.querySelector('.i-qty').value) || 0) * (Number(r.querySelector('.i-price').value) || 0));
        total.value = sum || '';
    }
    function addRow(data) {
        const node = tpl.content.firstElementChild.cloneNode(true);
        if (data) { node.querySelector('.i-name').value = data.name; node.querySelector('.i-qty').value = data.qty; node.querySelector('.i-price').value = data.price; }
        items.appendChild(node); renumber();
    }
    items.addEventListener('input', e => {
        const row = e.target.closest('.item-row');
        if (e.target.classList.contains('i-name')) {
            const p = products.find(p => p.name === e.target.value);
            row.querySelector('.i-pid').value = p ? p.id : '';
            if (p) row.querySelector('.i-price').value = p.price;
        }
        recalc();
    });
    items.addEventListener('click', e => { if (e.target.classList.contains('i-del')) { e.target.closest('.item-row').remove(); renumber(); recalc(); } });
    document.getElementById('addItem').onclick = () => addRow();
    const initial = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Input.Items.Select(i => new { name = i.Name, qty = i.Quantity, price = i.UnitPrice })));
    if (initial.length) initial.forEach(addRow); else addRow();

    // delivery toggle
    const del = document.getElementById('isDelivery'), block = document.getElementById('deliveryBlock');
    const toggle = () => block.hidden = !del.checked; del.onchange = toggle; toggle();

    // workload refresh when date changes
    const due = document.getElementById('dueDate'), exec = document.getElementById('executor');
    due.addEventListener('change', async () => {
        const r = await fetch('/api/workload?date=' + due.value); if (!r.ok) return;
        const list = await r.json();
        list.forEach(l => { const o = exec.querySelector(`option[value="${l.id}"]`); if (o) { o.textContent = l.label; o.className = 'load-' + l.level; } });
    });

    // customer lookup → shows previous issues
    const phone = document.getElementById('phone'), info = document.getElementById('custInfo'), issues = document.getElementById('issues');
    const esc = s => (s || '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    phone.addEventListener('change', async () => {
        info.textContent = ''; issues.innerHTML = '';
        if (phone.value.replace(/\D/g, '').length < 8) return;
        const r = await fetch('/api/customers/lookup?phone=' + encodeURIComponent(phone.value)); if (!r.ok) return;
        const c = await r.json();
        if (!c.found) { info.textContent = 'Նոր հաճախորդ'; return; }
        info.textContent = `Գրանցված հաճախորդ · ${c.orders} պատվեր`;
        const name = document.getElementById('custName'); if (!name.value) name.value = c.name;
        const addr = document.getElementById('address'); if (!addr.value && c.address) addr.value = c.address;
        const dist = document.getElementById('district'); if (!dist.value && c.district) dist.value = c.district;
        const open = c.issues.filter(i => !i.resolved);
        if (c.issues.length) issues.innerHTML = `<div class="alert alert-${open.length ? 'danger' : 'secondary'} py-2 mb-0 issue-warning"><b>Նախկինում առաջացած խնդիրներ</b><ul class="mb-0 small">` +
            c.issues.map(i => `<li>${i.date}: ${esc(i.description)}${i.resolved ? ' (լուծված)' : ''}</li>`).join('') + '</ul></div>';
        if (c.notes) issues.innerHTML += `<div class="small text-muted mt-1">Նշումներ՝ ${esc(c.notes)}</div>`;
    });
    if (phone.value) phone.dispatchEvent(new Event('change'));
})();
</script>
}
