@page
@model UGeekStore.Pages.Checklist.IndexModel
@{ ViewData["Title"] = "Չեկլիստ"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Կազմակերպչական չեկլիստ · @Model.Today.ToString("dd.MM")</h1>
    @if (User.IsAny(Roles.Management)) { <a class="btn btn-sm btn-outline-dark" href="/Checklist/Manage">Կառավարում / հաշվետվություններ</a> }
</div>
<div class="list-group">
@foreach (var r in Model.Rows)
{
    var done = r.Entry != null;
    <div class="list-group-item @(done ? "bg-light" : "")">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <div>
                <div class="@(done ? "text-decoration-line-through text-muted" : "fw-semibold")">@(done ? "✅" : "⬜") @r.Item.Title</div>
                <div class="small text-muted">@r.Item.Frequency.Hy() @(r.Item.RequiresMediaReport ? "· 📷 պահանջվում է նկար/վիդեո հաշվետվություն" : "")</div>
                @if (done)
                {
                    <div class="small">@r.Entry!.Employee?.FullName · @r.Entry.CompletedAt.ToString("dd.MM HH:mm") @r.Entry.Comment</div>
                    @if (r.Entry.ReportFilePath != null) { <a class="small" href="@r.Entry.ReportFilePath" target="_blank">Հաշվետվություն</a> }
                }
            </div>
        </div>
        @if (!done)
        {
            <form method="post" enctype="multipart/form-data" class="mt-2 complete-form">
                <input type="hidden" name="itemId" value="@r.Item.Id" />
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <label class="btn btn-sm btn-outline-dark mb-0">📷 Նկարել
                        <input type="file" name="photo" accept="image/*" capture="environment" hidden class="media" /></label>
                    <label class="btn btn-sm btn-outline-dark mb-0">🎥 Տեսագրել
                        <input type="file" name="video" accept="video/*" capture="environment" hidden class="media" /></label>
                    <span class="small text-success align-self-center media-name"></span>
                </div>
                <div class="d-flex gap-2">
                    <input name="comment" class="form-control form-control-sm" placeholder="Մեկնաբանություն" />
                    <button class="btn btn-sm btn-brand" data-req="@(r.Item.RequiresMediaReport ? "1" : "0")">Կատարված է</button>
                </div>
            </form>
        }
    </div>
}
</div>
@if (!Model.Rows.Any()) { <p class="text-muted">Ձեր դերի համար առաջադրանքներ չկան</p> }
@section Scripts {
<script>
document.querySelectorAll('.complete-form').forEach(f => {
    f.addEventListener('change', e => {
        if (!e.target.classList.contains('media')) return;
        const other = [...f.querySelectorAll('.media')].filter(i => i !== e.target);
        other.forEach(i => i.value = '');
        f.querySelector('.media-name').textContent = e.target.files[0]?.name || '';
    });
    f.addEventListener('submit', e => {
        const btn = f.querySelector('button[data-req]');
        const has = [...f.querySelectorAll('.media')].some(i => i.files.length);
        if (btn.dataset.req === '1' && !has) { e.preventDefault(); alert('Նկարեք կամ տեսագրեք հաշվետվությունը տեղում'); return; }
        btn.disabled = true; btn.textContent = 'Ուղարկվում է...';
    });
});
</script>
}
