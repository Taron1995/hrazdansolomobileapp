@page "{id:int}"
@model UGeekStore.Pages.Products.NotifyModel
@{ ViewData["Title"] = "Ծանուցում հաճախորդներին"; var p = Model.Product; }
<h1 class="h4 mb-3">Նոր տեսականի · ծանուցում</h1>
<div class="card card-body mb-3 d-flex flex-row gap-3 align-items-center">
    @if (p.PhotoPath != null) { <img src="@p.PhotoPath" class="thumb" alt="" /> }
    <div><div class="fw-semibold">@p.Name</div><div class="money">@p.Price.ToString("#,0") ֏</div></div>
</div>
<form method="post" class="card card-body mb-3">
    <label class="form-label">Հաղորդագրության տեքստ</label>
    <textarea name="text" class="form-control mb-2" rows="3">@Model.Text</textarea>
    <div class="small text-muted mb-2">Ստացողներ՝ @Model.Recipients.Count հաճախորդ (ովքեր համաձայն են ստանալ հաղորդագրություններ)</div>
    <div class="d-flex flex-wrap gap-2">
        <button name="channel" value="whatsapp" class="btn btn-success" disabled="@(!Model.WhatsAppApi)">Ուղարկել WhatsApp (նկար + անվանում + գին)</button>
        <button name="channel" value="sms" class="btn btn-outline-dark" disabled="@(!Model.SmsApi)">Ուղարկել SMS</button>
    </div>
    @if (!Model.WhatsAppApi || !Model.SmsApi)
    {
        <div class="small text-muted mt-2">Ավտոմատ ուղարկման համար կարգավորեք WhatsApp Business API / SMS gateway-ը (appsettings → Messaging)։ Մինչ այդ օգտագործեք ստորև նշված հղումները։</div>
    }
</form>
<div class="card card-body">
    <h2 class="h6">Ուղարկել ձեռքով WhatsApp-ով</h2>
    <div class="list-group list-group-flush">
    @foreach (var c in Model.Recipients)
    {
        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
            <span>@c.Name <span class="small text-muted">@Phone.Display(c.Phone)</span></span>
            <a class="btn btn-sm btn-outline-success" target="_blank" rel="noopener" href="@MessagingService.WhatsAppLink(c.Phone, Model.Text)">WhatsApp</a>
        </div>
    }
    </div>
</div>
