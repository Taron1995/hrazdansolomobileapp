@page
@model UGeekStore.Pages.Products.IndexModel
@{ ViewData["Title"] = "Տեսականի"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Տեսականի</h1>
    <a class="btn btn-brand" href="/Products/Edit">+ Նոր ապրանք</a>
</div>
<div class="list-group">
@foreach (var p in Model.Products)
{
    <div class="list-group-item d-flex gap-3 align-items-center @(p.IsActive ? "" : "opacity-50")">
        @if (p.PhotoPath != null) { <img src="@p.PhotoPath" class="thumb" alt="" /> } else { <div class="thumb bg-light"></div> }
        <div class="flex-fill">
            <div class="fw-semibold">@p.Name</div>
            <div class="small text-muted">@p.Category · <span class="money">@p.Price.ToString("#,0") ֏</span></div>
        </div>
        <div class="d-flex flex-column gap-1">
            <a class="btn btn-sm btn-outline-dark" href="/Products/Edit/@p.Id">Խմբագրել</a>
            <a class="btn btn-sm btn-brand" href="/Products/Notify/@p.Id">Ծանուցել</a>
        </div>
    </div>
}
</div>
@if (!Model.Products.Any()) { <p class="text-muted">Ապրանքներ դեռ չկան</p> }
